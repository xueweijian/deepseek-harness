{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Desktop - Electron shell around the DeepSeek Harness web UI, shipped with its own Node runtime.",
  "main": "dist-electron/main.cjs",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --external:electron-updater --sourcemap --outfile=dist-electron/main.cjs",
    "fetch-node": "node scripts/fetch-node.mjs",
    "runtime:install": "pnpm --dir runtime install --prod",
    "smoke": "node scripts/smoke-sidecar.mjs",
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "adm-zip": "0.6.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
